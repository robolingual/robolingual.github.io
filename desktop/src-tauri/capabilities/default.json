{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ファイルを選ぶ・読む・保存するための権限。",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        }
      ]
    }
  ]
}
